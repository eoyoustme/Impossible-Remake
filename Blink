local particleold = attachment and attachment:FindFirstChild("MainParticle")
local particlenew = attachment and attachment:FindFirstChild("AttackParticle")

local animPart = Blink:FindFirstChild("Animation", true) or part:FindFirstChild("Animation", true)
local animAttachment = animPart and (animPart:FindFirstChildWhichIsA("Attachment") or animPart)

local function playEyeAnimation(isAttacking)
	if not animAttachment then return end
	local closeEyes = animAttachment:FindFirstChild("CloseEyes")
	local open1 = animAttachment:FindFirstChild("OpenEyes1")
	local open2 = animAttachment:FindFirstChild("OpenEyes2")
	local open3 = animAttachment:FindFirstChild("OpenEyes3")
	local open4 = animAttachment:FindFirstChild("OpenEyes4")

	if isAttacking then
		if closeEyes then closeEyes.Enabled = false end
		if open1 then open1.Enabled = true end
		task.wait(0.1)
		if open1 then open1.Enabled = false end
		if open2 then open2.Enabled = true end
		task.wait(0.1)
		if open2 then open2.Enabled = false end
		if open3 then open3.Enabled = true end
		task.wait(0.1)
		if open3 then open3.Enabled = false end
		if open4 then open4.Enabled = true end
	else
		if open4 then open4.Enabled = false end
		if open3 then open3.Enabled = true end
		task.wait(0.1)
		if open3 then open3.Enabled = false end
		if open2 then open2.Enabled = true end
		task.wait(0.1)
		if open2 then open2.Enabled = false end
		if open1 then open1.Enabled = true end
		task.wait(0.1)
		if open1 then open1.Enabled = false end
		if closeEyes then closeEyes.Enabled = true end
	end
end

