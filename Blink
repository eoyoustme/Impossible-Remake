local targetCFrame = CFrame.new()
if currentLoadedRoom:FindFirstChild("Nodes") then
	local nodes = currentLoadedRoom.Nodes:GetChildren()
	local num = math.floor(#nodes / 2)
	local targetNode = nodes[num] or currentLoadedRoom:FindFirstChild(currentLoadedRoom.Name)
	if targetNode then
		targetCFrame = targetNode.CFrame + Vector3.new(0, 1.6, 0)
	end
else
	local entrance = currentLoadedRoom:FindFirstChild("RoomEntrance")
	if entrance then
		targetCFrame = entrance.CFrame * CFrame.new(0, 1.6, -20)
	end
end

local spawnCFrame = targetCFrame * CFrame.new(0, -70, 0)
if Blink:IsA("Model") then
	Blink:PivotTo(spawnCFrame)
else
	part.CFrame = spawnCFrame
end

local function playSound(id, volume, parent)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(id)
	sound.Volume = volume or 1
	sound.Parent = parent or part
	sound:Play()
	Debris:AddItem(sound, 10)
	return sound
end

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local function createCrater(centerCFrame)
	local count = 6       
	local radius = 5       
	local fadeTime = 2    

	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local offset = CFrame.Angles(0, angle, 0) * CFrame.new(0, -3, radius)
		local rockCF = centerCFrame * offset * CFrame.Angles(math.rad(-25), 0, 0)

		local rock = Instance.new("WedgePart") 
		rock.Size = Vector3.new(3, 2, 4)
		rock.CFrame = rockCF
		rock.Anchored = true
		rock.CanCollide = false
		rock.Material = Enum.Material.Slate
		rock.Color = Color3.fromRGB(100, 105, 110)
		rock.Parent = workspace

		local tweenInfo = TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(rock, tweenInfo, {
			Transparency = 1,
			Position = rock.Position - Vector3.new(0, 1, 0)
		})

		tween:Play()
		Debris:AddItem(rock, fadeTime + 0.2)
	end
end

